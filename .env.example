# Copy to `.env` to change how `docker compose` runs the game.

# Port the game is served on (default 3000).
#PORT=3000

# The address of this computer on your network, e.g. 192.168.1.20. Only used to print a
# usable "Other devices" link in the server log; inside Docker the server can't see it.
#ADVERTISE_HOST=

# Port of the hot-reloading client started with `--profile dev` (default 5173).
#DEV_PORT=5173
